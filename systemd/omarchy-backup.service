[Unit]
Description=Omarchy Backup
After=network-online.target
Wants=network-online.target
# nao trava o boot se a rede demorar; o timer tenta de novo

[Service]
Type=oneshot
# Arquivos de estado, logs e snapshots podem conter metadados pessoais.
UMask=0077
# roda "de fininho": prioridade baixa de CPU e I/O
Nice=15
IOSchedulingClass=idle
CPUSchedulingPolicy=idle

ExecStart=%h/.local/bin/omarchy-backup

# bisync no backend cifrado do Filen pode demorar; o script ja tem timeout
# interno por job (RCLONE_MAX_SECONDS). Este e so o teto do systemd.
TimeoutStartSec=4h

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
